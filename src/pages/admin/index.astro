---
import AdminLayout from '../../layouts/AdminLayout.astro';
---

<AdminLayout title="Painel de Controle - Tchê Urbano">
    <div class="p-8 max-w-7xl mx-auto w-full">
        
        <div class="mb-10">
            <h1 class="text-3xl font-bold text-gray-800 mb-2">Bem-vindo ao Admin Hub</h1>
            <p class="text-gray-600">Selecione uma ferramenta abaixo para gerenciar o Tchê Urbano.</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            
            <!-- Card: Fábrica de Vídeos -->
            <a href="/admin/studio" class="bg-white rounded-xl shadow-sm border border-gray-100 p-6 hover:shadow-md transition-shadow group">
                <div class="w-14 h-14 bg-[#821512] bg-opacity-10 rounded-lg flex items-center justify-center mb-4 group-hover:bg-[#821512] transition-colors">
                    <i class="fa-solid fa-video text-2xl text-[#821512] group-hover:text-white transition-colors"></i>
                </div>
                <h3 class="text-xl font-bold text-gray-800 mb-2">Fábrica de Vídeos</h3>
                <p class="text-gray-500 text-sm">Gere vídeos curtos (Reels/TikTok) customizados com sobreposições do Tchê Urbano em alta qualidade.</p>
            </a>

            <!-- Card: Gerador Collab -->
            <a href="/admin/collab" class="bg-white rounded-xl shadow-sm border border-gray-100 p-6 hover:shadow-md transition-shadow group">
                <div class="w-14 h-14 bg-[#B8860B] bg-opacity-10 rounded-lg flex items-center justify-center mb-4 group-hover:bg-[#B8860B] transition-colors">
                    <i class="fa-solid fa-images text-2xl text-[#B8860B] group-hover:text-white transition-colors"></i>
                </div>
                <h3 class="text-xl font-bold text-gray-800 mb-2">Gerador Collab</h3>
                <p class="text-gray-500 text-sm">Crie imagens personalizadas para Stories no Instagram convidando restaurantes para collab.</p>
            </a>

            <!-- Card: Placeholder Curadoria -->
            <div class="bg-gray-50 rounded-xl shadow-sm border border-gray-100 p-6 opacity-70">
                <div class="w-14 h-14 bg-gray-200 rounded-lg flex items-center justify-center mb-4">
                    <i class="fa-solid fa-list-check text-2xl text-gray-400"></i>
                </div>
                <h3 class="text-xl font-bold text-gray-600 mb-2">Curadoria (Em Breve)</h3>
                <p class="text-gray-500 text-sm">Gerencie os links de parceiros e a fila de processamento da curadoria de conteúdo.</p>
            </div>

        </div>
    </div>
</AdminLayout>
