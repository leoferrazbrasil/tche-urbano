---
// src/pages/admin/collab/index.astro
---
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Gerador de Story - Tchê Urbano</title>
    <!-- Google Fonts: Aleo -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Aleo:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">
    <!-- FontAwesome para Ícones -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    
    <!-- Use a very stable version of html2canvas -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
    
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            background-color: #222;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            font-family: 'Aleo', serif;
            padding: 20px;
        }

        .controls {
            margin-bottom: 20px;
            display: flex;
            gap: 15px;
            z-index: 100;
        }

        .btn {
            background-color: #821512;
            color: white;
            border: none;
            padding: 12px 24px;
            border-radius: 50px;
            font-family: 'Aleo', serif;
            font-weight: 700;
            font-size: 16px;
            cursor: pointer;
            box-shadow: 0 5px 15px rgba(0,0,0,0.3);
            transition: transform 0.2s;
        }

        .btn:hover {
            transform: translateY(-2px);
        }

        .btn-secondary {
            background-color: #333;
            border: 1px solid #555;
        }

        /* Container scale visual */
        .preview-wrapper {
            position: relative;
            transform-origin: top center;
            transform: scale(0.35); 
            height: calc(1920px * 0.35);
        }

        /* HARDCODED HEX COLORS EVERYWHERE TO AVOID HTML2CANVAS CSS VAR BUGS */
        .story-container {
            width: 1080px;
            height: 1920px;
            background-color: #FAF6F1;
            position: relative;
            overflow: hidden;
            display: flex;
            flex-direction: column;
        }

        /* Gradient using hardcoded hex/rgba */
        .story-gradient {
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: radial-gradient(circle at top center, rgba(130,21,18,0.07) 0%, rgba(250,246,241,0) 60%);
            z-index: 0;
        }

        .safe-zone {
            position: absolute;
            top: 250px;
            bottom: 250px;
            left: 50px;
            right: 50px;
            border: 2px dashed rgba(255, 0, 0, 0.5);
            pointer-events: none;
            z-index: 999;
            display: block;
        }
        
        .safe-zone::before {
            content: 'Safe Zone (Conteúdo Seguro)';
            position: absolute;
            top: -35px;
            left: 0;
            width: 100%;
            text-align: center;
            color: rgba(255, 0, 0, 0.8);
            font-family: sans-serif;
            font-size: 24px;
            font-weight: bold;
        }

        .content {
            position: relative;
            z-index: 10;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            height: 100%;
            padding: 250px 80px;
            text-align: center;
        }

        .logo-placeholder {
            width: 380px;
            height: auto;
            margin-bottom: 90px;
        }

        .invitation-text {
            color: #221512;
            font-size: 78px;
            font-weight: 500;
            line-height: 1.25;
            margin-bottom: 80px;
        }

        .invitation-text em {
            color: #821512;
            font-style: italic;
            font-weight: 700;
        }

        .brand-name {
            color: #821512;
            font-size: 130px;
            font-weight: 800;
            margin-bottom: 120px;
            letter-spacing: -2px;
        }

        .collab-badge {
            background-color: #ffffff;
            border: 2px solid rgba(34,21,18,0.08);
            padding: 35px 70px;
            border-radius: 100px;
            display: flex;
            align-items: center;
            gap: 24px;
            margin-bottom: 60px;
        }

        .collab-badge i {
            color: #B8860B;
            font-size: 65px;
        }

        .collab-badge-text-container {
            display: flex;
            flex-direction: column;
            align-items: flex-start;
            justify-content: center;
        }

        .collab-badge span {
            color: rgba(34,21,18,0.7);
            font-size: 50px;
            font-weight: 500;
        }

        .collab-badge strong {
            color: #821512;
            font-size: 60px;
            font-weight: 700;
        }

        .cta-text {
            font-size: 55px;
            color: rgba(34,21,18,0.7);
            font-weight: 600;
            margin-top: auto;
            background: rgba(255, 255, 255, 0.6);
            padding: 20px 50px;
            border-radius: 50px;
        }

        .glass-orb {
            position: absolute;
            bottom: -200px;
            right: -200px;
            width: 900px;
            height: 900px;
            background: radial-gradient(circle, rgba(184,134,11,0.06), rgba(250,246,241,0) 70%);
            border-radius: 50%;
            z-index: 1;
        }
    </style>
</head>
<body>

    <div class="controls">
        <button class="btn btn-secondary" onclick="toggleSafeZone()"><i class="fa-solid fa-border-all"></i> Alternar Safe Zone</button>
        <button class="btn" onclick="exportImage()"><i class="fa-solid fa-download"></i> Baixar Imagem (Alta Qualidade)</button>
    </div>

    <div class="preview-wrapper">
        <div class="story-container" id="storyNode">
            <div class="safe-zone" id="safeZone"></div>
            <div class="story-gradient"></div>
            <div class="glass-orb"></div>
            
            <div class="content">
                <img src="data:image/png;base64," alt="Tchê Urbano" class="logo-placeholder" onerror="this.style.display='none'">

                <h1 class="invitation-text">
                    O clube VIP para quem<br>ama a <em>Serra Gaúcha</em>.
                </h1>

                <div class="brand-name">
                    @tcheurbano
                </div>

                <div class="collab-badge">
                    <i class="fa-solid fa-handshake-angle"></i>
                    <div class="collab-badge-text-container">
                        <span>Convite especial por</span>
                        <!-- Espaço estratégico reservado para o sticker de Menção do Instagram (@) -->
                        <div style="height: 75px; width: 450px; margin-top: 10px;"></div>
                    </div>
                </div>

                <p class="cta-text"><i class="fa-solid fa-arrow-pointer"></i> Toque e economize até 50%</p>
            </div>
        </div>
    </div>

    <script>
        function toggleSafeZone() {
            const zone = document.getElementById('safeZone');
            if (zone.style.display === 'none') {
                zone.style.display = 'block';
            } else {
                zone.style.display = 'none';
            }
        }

        async function exportImage() {
            const originalNode = document.getElementById('storyNode');
            const clone = originalNode.cloneNode(true);
            
            const safeZone = clone.querySelector('#safeZone');
            if (safeZone) safeZone.style.display = 'none';

            clone.style.position = 'absolute';
            clone.style.top = '-10000px';
            clone.style.left = '-10000px';
            clone.style.transform = 'none';
            clone.style.width = '1080px';
            clone.style.height = '1920px';
            clone.style.margin = '0';
            clone.style.backgroundColor = '#FAF6F1';
            
            document.body.appendChild(clone);
            await new Promise(resolve => setTimeout(resolve, 300));

            const canvas = await html2canvas(clone, {
                scale: 1, 
                useCORS: true, 
                backgroundColor: "#FAF6F1",
                width: 1080,
                height: 1920,
                logging: false,
                allowTaint: true
            });

            document.body.removeChild(clone);

            const link = document.createElement('a');
            link.download = 'story-tcheurbano-cacamaru.png';
            link.href = canvas.toDataURL('image/png');
            link.click();
        }
    </script>
</body>
</html>