---
import AdminLayout from '../../../layouts/AdminLayout.astro';
---
<AdminLayout title="Gerador Collab | Tchê Urbano">
    <Fragment slot="head">
        <!-- Use a very stable version of html2canvas -->
        <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
        
        <style>
            * {
                box-sizing: border-box;
                margin: 0;
                padding: 0;
            }

            .collab-container {
                background-color: #222;
                display: flex;
                flex-direction: column;
                justify-content: center;
                align-items: center;
                min-height: 100%;
                font-family: 'Aleo', serif;
                padding: 40px;
                width: 100%;
            }

            .controls {
                margin-bottom: 20px;
                display: flex;
                gap: 15px;
                z-index: 100;
            }

            .btn {
                background-color: #821512;
                color: white;
                border: none;
                padding: 12px 24px;
                border-radius: 50px;
                font-family: 'Aleo', serif;
                font-weight: 700;
                font-size: 16px;
                cursor: pointer;
                box-shadow: 0 5px 15px rgba(0,0,0,0.3);
                transition: transform 0.2s;
            }

            .btn:hover {
                transform: translateY(-2px);
            }

            .btn-secondary {
                background-color: #333;
                border: 1px solid #555;
            }

            /* Container scale visual */
            .preview-wrapper {
                position: relative;
                transform-origin: top center;
                transform: scale(0.35); 
                height: calc(1920px * 0.35);
            }

            /* HARDCODED HEX COLORS EVERYWHERE TO AVOID HTML2CANVAS CSS VAR BUGS */
            .story-container {
                width: 1080px;
                height: 1920px;
                background-color: #FAF6F1;
                position: relative;
                overflow: hidden;
                display: flex;
                flex-direction: column;
            }

            /* Gradient using hardcoded hex/rgba */
            .story-gradient {
                position: absolute;
                top: 0;
                left: 0;
                right: 0;
                bottom: 0;
                background: radial-gradient(circle at top center, rgba(130,21,18,0.07) 0%, rgba(250,246,241,0) 60%);
                z-index: 0;
            }

            .safe-zone {
                position: absolute;
                top: 250px;
                bottom: 250px;
                left: 50px;
                right: 50px;
                border: 2px dashed rgba(255, 0, 0, 0.5);
                pointer-events: none;
                z-index: 999;
                display: block;
            }
            
            .safe-zone::before {
                content: 'Safe Zone (Conteúdo Seguro)';
                position: absolute;
                top: -35px;
                left: 0;
                width: 100%;
                text-align: center;
                color: rgba(255, 0, 0, 0.8);
                font-family: sans-serif;
                font-size: 24px;
                font-weight: bold;
            }

            .content {
                position: relative;
                z-index: 10;
                display: flex;
                flex-direction: column;
                align-items: center;
                justify-content: center;
                height: 100%;
                padding: 250px 80px;
                text-align: center;
            }

            .logo-placeholder {
                width: 380px;
                height: auto;
                margin-bottom: 90px;
            }

            .invitation-text {
                color: #221512;
                font-size: 78px;
                font-weight: 500;
                line-height: 1.25;
                margin-bottom: 80px;
            }

            .invitation-text em {
                color: #821512;
                font-style: italic;
                font-weight: 700;
            }

            .brand-name {
                color: #821512;
                font-size: 130px;
                font-weight: 800;
                margin-bottom: 120px;
                letter-spacing: -2px;
            }

            .collab-badge {
                background-color: #ffffff;
                border: 2px solid rgba(34,21,18,0.08);
                padding: 35px 70px;
                border-radius: 100px;
                display: flex;
                align-items: center;
                gap: 24px;
                margin-bottom: 60px;
            }

            .collab-badge i {
                color: #B8860B;
                font-size: 65px;
            }

            .collab-badge-text-container {
                display: flex;
                flex-direction: column;
                align-items: flex-start;
                justify-content: center;
            }

            .collab-badge span {
                color: rgba(34,21,18,0.7);
                font-size: 50px;
                font-weight: 500;
            }

            .collab-badge strong {
                color: #821512;
                font-size: 60px;
                font-weight: 700;
            }

            .cta-text {
                font-size: 55px;
                color: rgba(34,21,18,0.7);
                font-weight: 600;
                margin-top: auto;
                background: rgba(255, 255, 255, 0.6);
                padding: 20px 50px;
                border-radius: 50px;
            }

            .glass-orb {
                position: absolute;
                bottom: -200px;
                right: -200px;
                width: 900px;
                height: 900px;
                background: radial-gradient(circle, rgba(184,134,11,0.06), rgba(250,246,241,0) 70%);
                border-radius: 50%;
                z-index: 1;
            }
        </style>
    </Fragment>

    <div class="collab-container">
        <div class="controls">
            <button class="btn btn-secondary" onclick="toggleSafeZone()"><i class="fa-solid fa-border-all"></i> Alternar Safe Zone</button>
            <button class="btn" onclick="exportImage()"><i class="fa-solid fa-download"></i> Baixar Imagem (Alta Qualidade)</button>
        </div>

        <div class="preview-wrapper">
            <div class="story-container" id="storyNode">
                <div class="safe-zone" id="safeZone"></div>
                <div class="story-gradient"></div>
                <div class="glass-orb"></div>
                
                <div class="content">
                    <img src="data:image/png;base64," />
                </div>
            </div>
        </div>

        <script is:inline>
            function toggleSafeZone() {
                const zone = document.getElementById('safeZone');
                zone.style.display = zone.style.display === 'none' ? 'block' : 'none';
            }

            async function exportImage() {
                const storyNode = document.getElementById('storyNode');
                const safeZone = document.getElementById('safeZone');
                
                // Hide safe zone before exporting
                safeZone.style.display = 'none';

                try {
                    const canvas = await html2canvas(storyNode, {
                        scale: 1, // Exatamente 1080x1920
                        useCORS: true,
                        allowTaint: true,
                        backgroundColor: '#FAF6F1'
                    });

                    const link = document.createElement('a');
                    link.download = 'story_collab_tche_urbano.png';
                    link.href = canvas.toDataURL('image/png', 1.0);
                    link.click();
                } catch (err) {
                    console.error('Erro ao gerar imagem:', err);
                    alert('Erro ao gerar a imagem. Verifique o console.');
                } finally {
                    // Restore safe zone
                    safeZone.style.display = 'block';
                }
            }
        </script>
    </div>
</AdminLayout>