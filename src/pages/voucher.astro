<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Seu Voucher VIP | Tchê Urbano</title>
    <meta name="description" content="Voucher oficial de desconto do Clube VIP Tchê Urbano. Apresente este QR Code no estabelecimento para obter o desconto.">
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
    
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    
    <!-- QRCode JS Generator -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>

    <!-- Stylesheets -->
    <link rel="stylesheet" href="/styles.css">
    <style>
        .voucher-page-body {
            background: #F4EFEA;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }
        .voucher-card-wrapper {
            max-width: 460px;
            margin: 30px auto;
            padding: 0 16px;
            flex: 1;
        }
        .voucher-ticket {
            background: #FFFFFF;
            border-radius: var(--radius-lg);
            overflow: hidden;
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.12);
            border: 1px solid rgba(130, 21, 18, 0.15);
            position: relative;
        }
        .ticket-header {
            background: linear-gradient(135deg, #821512 0%, #430A08 100%);
            color: #FFFFFF;
            padding: 24px 20px;
            text-align: center;
        }
        .ticket-logo {
            height: 38px;
            margin-bottom: 8px;
        }
        .ticket-badge {
            display: inline-block;
            background: var(--accent-gold);
            color: #FFFFFF;
            font-family: var(--font-heading);
            font-size: 0.75rem;
            font-weight: 700;
            padding: 4px 12px;
            border-radius: var(--radius-full);
            text-transform: uppercase;
            letter-spacing: 1px;
        }
        .ticket-body {
            padding: 24px 20px;
            text-align: center;
        }
        .ticket-merchant {
            font-size: 1.3rem;
            font-weight: 800;
            color: var(--text-main);
            margin-bottom: 4px;
        }
        .ticket-location {
            font-size: 0.85rem;
            color: var(--text-muted);
            margin-bottom: 16px;
        }
        .ticket-offer-title {
            font-size: 1.05rem;
            font-weight: 700;
            color: var(--primary);
            margin-bottom: 16px;
            padding-bottom: 16px;
            border-bottom: 1px dashed var(--border-color);
        }
        .price-box {
            background: rgba(130, 21, 18, 0.05);
            border: 1px solid rgba(130, 21, 18, 0.15);
            border-radius: var(--radius-md);
            padding: 14px;
            margin-bottom: 20px;
        }
        .price-box del {
            color: var(--text-muted);
            font-size: 0.9rem;
        }
        .price-box .final-price {
            font-family: var(--font-heading);
            font-size: 1.8rem;
            font-weight: 800;
            color: var(--primary);
            display: block;
        }
        .qrcode-container {
            display: flex;
            justify-content: center;
            align-items: center;
            margin: 20px 0;
        }
        .qrcode-container img, .qrcode-container canvas {
            padding: 10px;
            background: #FFF;
            border: 1px solid var(--border-color);
            border-radius: var(--radius-md);
        }
        .voucher-code-text {
            font-family: monospace;
            font-size: 1.1rem;
            font-weight: 700;
            letter-spacing: 2px;
            color: var(--text-main);
            background: #F3F4F6;
            padding: 6px 14px;
            border-radius: var(--radius-md);
            display: inline-block;
            margin-bottom: 16px;
        }
        .ticket-instructions {
            font-size: 0.82rem;
            color: var(--text-muted);
            line-height: 1.5;
            margin-bottom: 20px;
        }
        .ticket-actions {
            display: flex;
            flex-direction: column;
            gap: 10px;
        }
        .btn-confirm-wa {
            background: var(--accent-whatsapp);
            color: #FFF;
            width: 100%;
            padding: 14px;
            font-weight: 700;
        }
        .btn-confirm-wa:hover {
            background: var(--accent-whatsapp-hover);
        }
    </style>
</head>
<body class="voucher-page-body">

    <!-- Header -->
    <header class="navbar">
        <div class="container nav-container">
            <a href="/" class="brand-logo">
                <img src="assets/img/logo-tche-urbano.png" alt="Tchê Urbano" class="logo-img">
            </a>
            <a href="/" class="btn btn-secondary" style="font-size: 0.85rem;"><i class="fa-solid fa-house"></i> Voltar ao Site</a>
        </div>
    </header>

    <!-- Main Ticket Section -->
    <main class="voucher-card-wrapper">
        <div class="voucher-ticket">
            <div class="ticket-header">
                <span class="ticket-badge"><i class="fa-solid fa-crown"></i> VOUCHER OFICIAL CLUBE VIP</span>
            </div>

            <div class="ticket-body">
                <h1 class="ticket-merchant" id="merchantName">Toca da Bruxa Canela</h1>
                <div class="ticket-location" id="merchantLocation"><i class="fa-solid fa-location-dot"></i> Gramado & Canela • Centro</div>

                <div class="ticket-offer-title" id="offerTitle">Rodízio de Pizzas Temático (+50 Sabores)</div>

                <div class="price-box">
                    <span>Preço no Cardápio: <del id="oldPrice">De R$ 149,00</del></span>
                    <span class="final-price" id="newPrice">R$ 94,00</span>
                    <span style="font-size: 0.82rem; color: #10B981; font-weight: 700;" id="savingsText">Economia de R$ 55,00 por pessoa</span>
                </div>

                <!-- QR Code Target -->
                <div class="qrcode-container" id="qrcode"></div>
                <div class="voucher-code-text" id="voucherCode">TCHE-BRUXA-94</div>

                <p class="ticket-instructions">
                    <i class="fa-solid fa-circle-info"></i> <strong>Como usar:</strong> Apresente a tela com este QR Code ao garçom no restaurante no momento de pedir a conta.
                </p>

                <div class="ticket-actions">
                    <a href="#" id="btnWhatsappConfirm" target="_blank" class="btn btn-confirm-wa">
                        <i class="fa-brands fa-whatsapp"></i> Confirmar Reserva no WhatsApp
                    </a>
                    <button type="button" onclick="window.print()" class="btn btn-secondary">
                        <i class="fa-solid fa-print"></i> Salvar / Imprimir Voucher
                    </button>
                </div>
            </div>
        </div>
    </main>

    <script>
        document.addEventListener("DOMContentLoaded", () => {
            const urlParams = new URLSearchParams(window.location.search);
            const code = (urlParams.get("code") || urlParams.get("v") || "TCHE-BRUXA-94").toUpperCase();

            const merchantName = urlParams.get("m") || "Toca da Bruxa Canela";
            const title = urlParams.get("t") || "Rodízio de Pizzas Temático (+50 Sabores)";
            const oldP = urlParams.get("old") || "149.00";
            const newP = urlParams.get("new") || "94.00";

            document.getElementById("voucherCode").textContent = code;
            document.getElementById("merchantName").textContent = merchantName;
            document.getElementById("offerTitle").textContent = title;
            document.getElementById("oldPrice").textContent = `De R$ ${parseFloat(oldP).toFixed(2).replace('.', ',')}`;
            document.getElementById("newPrice").textContent = `R$ ${parseFloat(newP).toFixed(2).replace('.', ',')}`;

            const oldNum = parseFloat(oldP);
            const newNum = parseFloat(newP);
            if (oldNum > newNum) {
                const diff = oldNum - newNum;
                document.getElementById("savingsText").textContent = `Economia de R$ ${diff.toFixed(2).replace('.', ',')} por pessoa`;
            }

            // Generate Validation Link for QR Code
            const validationUrl = `https://www.tcheurbano.com.br/validar.html?v=${code}`;
            
            // Render QR Code
            new QRCode(document.getElementById("qrcode"), {
                text: validationUrl,
                width: 160,
                height: 160,
                colorDark : "#821512",
                colorLight : "#ffffff",
                correctLevel : QRCode.CorrectLevel.H
            });

            // Set WhatsApp Confirm Link
            const waMsg = `Olá! Acabei de gerar meu Voucher VIP no site Tchê Urbano!\n\n` +
                `► *Oferta:* ${title}\n` +
                `► *Estabelecimento:* ${merchantName}\n` +
                `► *Preço VIP:* R$ ${parseFloat(newP).toFixed(2)}\n` +
                `► *Código do Voucher:* ${code}\n` +
                `► *Link de Validação:* ${validationUrl}`;

            document.getElementById("btnWhatsappConfirm").href = `https://api.whatsapp.com/send?phone=5551996737359&text=${encodeURIComponent(waMsg)}`;
        });
    </script>
</body>
</html>
