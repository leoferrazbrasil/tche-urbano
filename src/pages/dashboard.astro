<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Painel de Controle B2B | Tchê Urbano</title>
    <meta name="description" content="Dashboard em tempo real do parceiro comercial. Acompanhe vouchers resgatados, validados no caixa e faturamento gerado.">
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
    
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    
    <!-- Supabase JS Client SDK -->
    <script is:inline src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
    <script is:inline src="/supabase.js"></script>

    <!-- Stylesheets -->
    <link rel="stylesheet" href="/styles.css">
    <style>
        .dashboard-body {
            background: #F8F6F2;
            min-height: 100vh;
        }
        .dash-container {
            padding: 30px 20px;
            max-width: 1200px;
            margin: 0 auto;
        }
        .dash-header-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 30px;
            flex-wrap: wrap;
            gap: 16px;
        }
        .dash-title h1 {
            font-size: clamp(1.5rem, 3vw, 2.2rem);
            color: var(--primary);
            margin-bottom: 4px;
        }
        .dash-title p {
            color: var(--text-muted);
            font-size: 0.95rem;
        }
        .merchant-pill-badge {
            background: var(--bg-card);
            border: 1px solid var(--border-color);
            padding: 8px 16px;
            border-radius: var(--radius-full);
            font-weight: 700;
            font-size: 0.9rem;
            display: flex;
            align-items: center;
            gap: 8px;
            box-shadow: var(--shadow-card);
        }

        /* KPI Cards Grid */
        .kpi-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr));
            gap: 20px;
            margin-bottom: 36px;
        }
        .kpi-card {
            background: var(--bg-card);
            border: 1px solid var(--border-color);
            border-radius: var(--radius-lg);
            padding: 24px;
            box-shadow: var(--shadow-card);
            position: relative;
            overflow: hidden;
        }
        .kpi-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 4px;
            background: var(--primary);
        }
        .kpi-card.kpi-green::before { background: #10B981; }
        .kpi-card.kpi-gold::before { background: var(--accent-gold); }
        .kpi-card.kpi-blue::before { background: #3B82F6; }

        .kpi-label {
            font-size: 0.85rem;
            color: var(--text-muted);
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin-bottom: 10px;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }
        .kpi-value {
            font-family: var(--font-heading);
            font-size: 2.1rem;
            font-weight: 800;
            color: var(--text-main);
            margin-bottom: 6px;
        }
        .kpi-subtext {
            font-size: 0.8rem;
            color: var(--text-muted);
        }

        /* Audit Data Table Card */
        .table-card {
            background: var(--bg-card);
            border: 1px solid var(--border-color);
            border-radius: var(--radius-lg);
            padding: 24px;
            box-shadow: var(--shadow-card);
            margin-bottom: 30px;
        }
        .table-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 20px;
            flex-wrap: wrap;
            gap: 12px;
        }
        .table-header h2 {
            font-size: 1.25rem;
            color: var(--primary);
        }
        .search-table-input {
            padding: 8px 16px;
            border: 1px solid var(--border-color);
            border-radius: var(--radius-full);
            font-size: 0.88rem;
            outline: none;
            width: 250px;
        }
        .table-wrapper {
            overflow-x: auto;
        }
        .dash-table {
            width: 100%;
            border-collapse: collapse;
            text-align: left;
            font-size: 0.9rem;
        }
        .dash-table th {
            background: rgba(130, 21, 18, 0.04);
            padding: 12px 16px;
            font-family: var(--font-heading);
            font-weight: 700;
            color: var(--primary);
            border-bottom: 1px solid var(--border-color);
        }
        .dash-table td {
            padding: 14px 16px;
            border-bottom: 1px solid var(--border-color);
        }
        .dash-table tr:hover {
            background: rgba(0, 0, 0, 0.015);
        }
        .status-tag {
            display: inline-block;
            padding: 4px 10px;
            border-radius: var(--radius-full);
            font-size: 0.78rem;
            font-weight: 700;
        }
        .status-tag.validado {
            background: #D1FAE5;
            color: #065F46;
        }
        .status-tag.gerado {
            background: #FEF3C7;
            color: #92400E;
        }

        /* Offer Control Panel */
        .controls-card {
            background: var(--bg-card);
            border: 1px solid var(--border-color);
            border-radius: var(--radius-lg);
            padding: 24px;
            box-shadow: var(--shadow-card);
        }
        .offer-item-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 16px;
            background: var(--bg-main);
            border: 1px solid var(--border-color);
            border-radius: var(--radius-md);
            margin-top: 14px;
        }
        .switch-toggle {
            position: relative;
            display: inline-block;
            width: 50px;
            height: 26px;
        }
        .switch-toggle input { opacity: 0; width: 0; height: 0; }
        .slider {
            position: absolute; cursor: pointer; top: 0; left: 0; right: 0; bottom: 0;
            background-color: #CCC; transition: .4s; border-radius: 34px;
        }
        .slider:before {
            position: absolute; content: ""; height: 18px; width: 18px; left: 4px; bottom: 4px;
            background-color: white; transition: .4s; border-radius: 50%;
        }
        input:checked + .slider { background-color: #10B981; }
        input:checked + .slider:before { transform: translateX(24px); }
    </style>
</head>
<body class="dashboard-body">

    <!-- Header / Navbar -->
    <header class="navbar">
        <div class="container nav-container">
            <a href="/" class="brand-logo">
                <img src="assets/img/logo-tche-urbano.png" alt="Tchê Urbano" class="logo-img">
                <span class="badge-beta">DASHBOARD SUPABASE B2B</span>
            </a>
            <div class="nav-actions">
                <div class="merchant-pill-badge" id="merchantBadge">
                    <i class="fa-solid fa-shop text-primary"></i> <span id="lblMerchantName">Toca da Bruxa Canela</span>
                </div>
                <a href="/validar" class="btn btn-primary" style="font-size: 0.85rem;"><i class="fa-solid fa-qrcode"></i> Leitor QR Code</a>
            </div>
        </div>
    </header>

    <main class="dash-container">
        <!-- Header Row -->
        <div class="dash-header-row">
            <div class="dash-title">
                <h1><i class="fa-solid fa-chart-line"></i> Desempenho em Tempo Real</h1>
                <p>Acompanhe o retorno sobre o investimento gerado pelo Clube VIP do Tchê Urbano.</p>
            </div>
            <div>
                <button type="button" class="btn btn-secondary" onclick="fetchRealtimeMetrics()"><i class="fa-solid fa-rotate"></i> Atualizar Dados</button>
            </div>
        </div>

        <!-- 4 Top KPI Cards -->
        <div class="kpi-grid">
            <div class="kpi-card kpi-blue">
                <div class="kpi-label">
                    <span>Vouchers Emitidos</span>
                    <i class="fa-solid fa-ticket"></i>
                </div>
                <div class="kpi-value" id="kpiIssued">142</div>
                <div class="kpi-subtext">Total de clientes que resgataram o cupom</div>
            </div>

            <div class="kpi-card kpi-green">
                <div class="kpi-label">
                    <span>Validados no Caixa</span>
                    <i class="fa-solid fa-circle-check"></i>
                </div>
                <div class="kpi-value" id="kpiValidated">98</div>
                <div class="kpi-subtext">Clientes que consumiram no restaurante</div>
            </div>

            <div class="kpi-card kpi-gold">
                <div class="kpi-label">
                    <span>Faturamento Gerado</span>
                    <i class="fa-solid fa-sack-dollar"></i>
                </div>
                <div class="kpi-value" id="kpiRevenue">R$ 9.212,00</div>
                <div class="kpi-subtext">Receita bruta trazida pelo Tchê Urbano</div>
            </div>

            <div class="kpi-card">
                <div class="kpi-label">
                    <span>Taxa de Conversão</span>
                    <i class="fa-solid fa-percent"></i>
                </div>
                <div class="kpi-value" id="kpiConversion">69%</div>
                <div class="kpi-subtext">Taxa de presença física no estabelecimento</div>
            </div>
        </div>

        <!-- Audit Table Card -->
        <div class="table-card">
            <div class="table-header">
                <h2><i class="fa-solid fa-list-check"></i> Histórico Recente de Cupons</h2>
                <input type="text" id="tableFilter" class="search-table-input" placeholder="Filtrar por código ou oferta...">
            </div>

            <div class="table-wrapper">
                <table class="dash-table">
                    <thead>
                        <tr>
                            <th>Código Voucher</th>
                            <th>Oferta</th>
                            <th>Valor Promocional</th>
                            <th>Status</th>
                            <th>Data de Resgate</th>
                            <th>Data de Validação</th>
                        </tr>
                    </thead>
                    <tbody id="tableBody">
                        <!-- Dynamic Data -->
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Offer Control Panel -->
        <div class="controls-card">
            <h2><i class="fa-solid fa-sliders"></i> Gestão de Ofertas Ativas</h2>
            <p style="color: var(--text-muted); font-size: 0.9rem; margin-bottom: 16px;">Pause sua oferta temporariamente em dias de capacidade esgotada.</p>
            
            <div class="offer-item-row">
                <div>
                    <strong>Toca da Bruxa Canela | Rodízio de Pizzas Temático (+50 Sabores)</strong>
                    <div style="font-size: 0.82rem; color: var(--text-muted);">De R$ 149,00 por R$ 94,00 (-37% OFF)</div>
                </div>
                <label class="switch-toggle">
                    <input type="checkbox" checked id="toggleOfferStatus" onchange="toggleOfferActive(this.checked)">
                    <span class="slider"></span>
                </label>
            </div>
        </div>
    </main>

    <!-- Footer -->
    <footer class="footer text-center" style="padding: 30px 0;">
        <p>&copy; 2026 Tchê Urbano. Dashboard B2B Conectado ao Supabase Backend.</p>
    </footer>

    <!-- Dashboard Logic Script -->
    <script is:inline src="/dashboard.js"></script>
</body>
</html>
